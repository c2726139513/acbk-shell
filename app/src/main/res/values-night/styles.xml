<resources>
    <!--
      系统深色模式下的同一套主题（night 资源限定符，由系统自动选择）。
      父主题不带 .Light，于是 android:isLightTheme=false，WebView 就会向网页
      报告 prefers-color-scheme: dark，面板自带的深色配色随之生效。
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <!--
          深色下状态栏跟面板背景同色，融为一体。
          浅色下仍是品牌蓝 #4d6bfe —— 两个文件各自独立，互不影响。
          这里也正好对上面板 index.html 里声明的
          <meta name="theme-color" media="(prefers-color-scheme: dark)"> 的取值。
        -->
        <item name="android:statusBarColor">#131417</item>
        <!-- 与面板深色背景色一致 -->
        <item name="android:windowBackground">#131417</item>
    </style>
</resources>
